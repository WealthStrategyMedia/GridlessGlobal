# ---------------------------------------------------------------------------
# Gridless Global - environment variables
# Copy to `.env` for local dev; set the same keys in Netlify -> Site settings ->
# Environment variables for deploys. Nothing here is required to BUILD the site.
# ---------------------------------------------------------------------------

# --- Forms -----------------------------------------------------------------
# Public endpoint the browser POSTs every form to. Leave blank and the forms
# render + validate but report "not yet connected" instead of submitting.
# Set this to your Tweeble / CRM intake endpoint when it is ready.
PUBLIC_FORMS_ENDPOINT=

# Optional: if you would rather relay through the bundled Netlify Function
# (netlify/functions/submit-form.mts), point the above at "/api/forms" and set
# the upstream URL + auth here. These stay server-side.
FORMS_UPSTREAM_URL=
FORMS_UPSTREAM_TOKEN=

# --- Payments --------------------------------------------------------------
# Which provider netlify/functions/create-checkout-session.mts should talk to.
# Supported today: "stripe". "tweeble" is stubbed for the future integration.
PAYMENTS_PROVIDER=stripe

# Stripe. Publishable key is exposed to the browser; secret key never is.
PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Tweeble (placeholder - fill in when the integration lands)
TWEEBLE_API_BASE=
TWEEBLE_API_KEY=

# --- Site ------------------------------------------------------------------
PUBLIC_SITE_URL=https://gridlessglobal.com
