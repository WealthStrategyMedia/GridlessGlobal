---
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs?: Crumb[];
  icon?: IconName;
  accentClass?: string;
  class?: string;
}

const { eyebrow, title, lead, crumbs = [], icon, accentClass = 'text-brand-300', class: className = '' } =
  Astro.props;
---
<section class={`aurora grid-lines relative overflow-hidden border-b border-white/[0.06] ${className}`}>
  <div class="shell py-14 lg:py-20">
    {
      crumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="mb-7">
          <ol class="flex flex-wrap items-center gap-2 text-[0.8rem] text-ink-faint">
            {crumbs.map((crumb, i) => (
              <li class="flex items-center gap-2">
                {crumb.href ? (
                  <a href={crumb.href} class="transition-colors hover:text-ink">
                    {crumb.label}
                  </a>
                ) : (
                  <span class="text-ink-muted" aria-current="page">
                    {crumb.label}
                  </span>
                )}
                {i < crumbs.length - 1 && <Icon name="chevron-right" size={13} class="opacity-50" />}
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:gap-10">
      {
        icon && (
          <span
            class={`flex h-16 w-16 shrink-0 items-center justify-center rounded-3xl border border-white/12 bg-white/[0.05] ${accentClass}`}
          >
            <Icon name={icon} size={30} />
          </span>
        )
      }
      <div class="max-w-4xl">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1 class="mt-3 font-display text-4xl font-extrabold leading-[1.08] sm:text-5xl lg:text-6xl">
          {title}
        </h1>
        {lead && <p class="mt-6 text-[1.05rem] leading-relaxed text-ink-muted lg:text-[1.15rem]">{lead}</p>}
        <slot />
      </div>
    </div>
  </div>
</section>
