---
/**
 * Brand lockup - the artwork supplied in Context/Logo, sitting directly on the
 * page with no plate or container behind it.
 *
 * Two variants are generated by scripts/prepare-assets.mjs. On dark surfaces we
 * use the light one, whose wordmark is lifted to light tints while keeping its
 * hues, so the mark stays multi-coloured and still reads; the globe is
 * untouched in both. On light surfaces we use the artwork exactly as supplied.
 *
 * Note on `class`: this sets `inline-flex`, which Tailwind emits after
 * `hidden`, so passing `hidden` in here will not hide the lockup. Put
 * responsive display classes on a wrapper element instead.
 */
interface Props {
  size?: 'sm' | 'md' | 'lg';
  /** Globe only - for tight spaces where a wide lockup will not fit. */
  markOnly?: boolean;
  /** Which background this sits on. Picks the matching artwork variant. */
  on?: 'dark' | 'light';
  class?: string;
}

const { size = 'md', markOnly = false, on = 'dark', class: className = '' } = Astro.props;

const lockupWidth = { sm: 'w-[132px]', md: 'w-[164px]', lg: 'w-[248px]' }[size];
const sizes = { sm: '132px', md: '164px', lg: '248px' }[size];
const markSize = { sm: 'h-9 w-9', md: 'h-11 w-11', lg: 'h-16 w-16' }[size];

const base = on === 'light' ? '/images/logo-lockup' : '/images/logo-lockup-light';
const fallback = on === 'light' ? '/images/logo-lockup.png' : '/images/logo-lockup-light-560.png';
const srcset =
  on === 'light'
    ? '/images/logo-lockup.webp 900w'
    : `${base}-320.webp 320w, ${base}-560.webp 560w, ${base}.webp 900w`;
---
{
  markOnly ? (
    <span class={`inline-flex items-center ${className}`}>
      <img
        src="/images/logo-mark.png"
        alt="Gridless Global"
        width="280"
        height="265"
        loading="eager"
        decoding="async"
        class={`${markSize} shrink-0 object-contain`}
      />
    </span>
  ) : (
    <span class={`inline-flex items-center ${className}`}>
      <picture>
        <source type="image/webp" srcset={srcset} sizes={sizes} />
        <img
          src={fallback}
          alt="Gridless Global - Powering a Connected Future"
          width="1049"
          height="324"
          loading="eager"
          decoding="async"
          class={`${lockupWidth} h-auto object-contain`}
        />
      </picture>
    </span>
  )
}
