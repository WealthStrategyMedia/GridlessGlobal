---
/**
 * Brand lockup.
 *
 * The supplied artwork renders its wordmark in deep navy, which disappears
 * against our dark UI, so the globe mark is used as the image and the wordmark
 * is set in live type. That also keeps it crisp at every size and readable to
 * screen readers and search engines.
 *
 * Note on `class`: this sets `inline-flex`, which Tailwind emits after
 * `hidden`, so passing `hidden` in here will not hide the lockup. Put
 * responsive display classes on a wrapper element instead.
 */
interface Props {
  size?: 'sm' | 'md' | 'lg';
  /** Hide the wordmark and show the globe only (used in the mobile bar). */
  markOnly?: boolean;
  showTagline?: boolean;
  class?: string;
}

const { size = 'md', markOnly = false, showTagline = false, class: className = '' } = Astro.props;

const markSize = { sm: 'h-8 w-8', md: 'h-11 w-11', lg: 'h-16 w-16' }[size];
const titleSize = { sm: 'text-base', md: 'text-xl', lg: 'text-3xl' }[size];
const subSize = { sm: 'text-[0.5rem]', md: 'text-[0.6rem]', lg: 'text-[0.78rem]' }[size];
---
<span class={`inline-flex items-center gap-3 ${className}`}>
  <img
    src="/images/logo-mark.png"
    alt=""
    width="433"
    height="383"
    aria-hidden="true"
    loading="eager"
    decoding="async"
    class={`${markSize} shrink-0 object-contain drop-shadow-[0_0_18px_rgba(63,208,106,.35)]`}
  />
  {
    !markOnly && (
      <span class="flex flex-col leading-none">
        <span class={`font-display font-extrabold ${titleSize} tracking-[0.14em] text-white`}>
          GRIDLESS
        </span>
        <span
          class={`mt-1 font-display font-semibold ${subSize} tracking-[0.42em] text-signal-400`}
        >
          GLOBAL
        </span>
        {showTagline && (
          <span class="mt-2 font-display text-[0.55rem] tracking-[0.3em] text-ink-faint uppercase">
            Powering a Connected Future
          </span>
        )}
      </span>
    )
  }
</span>
