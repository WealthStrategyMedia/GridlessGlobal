---
import Field from './forms/Field.astro';
import Icon from './Icon.astro';
import {
  paymentForm,
  PAYMENT_FIELDS,
  PAYMENT_REASONS,
  amountIsPayerChosen,
  minimumAmount,
  fixedAmount,
  isRequired,
} from '~/data/payments';

/**
 * Payment intake, wired to the live Tweeble payment form.
 *
 * This is our own markup rather than Tweeble's embed script, so the form
 * matches the rest of the site. It posts straight to their submit endpoint and
 * forwards the payer to the hosted checkout URL that comes back. Card details
 * are only ever entered on that hosted page.
 *
 * Field ids and the minimum amount come from the committed form snapshot - see
 * src/data/payments.ts.
 */

const reasonOptions = PAYMENT_REASONS.map((reason) => ({ value: reason, label: reason }));
const amountLabel = fixedAmount != null ? `Amount (${fixedAmount.toFixed(2)})` : 'Amount';
---
<div class="panel rounded-4xl p-7 sm:p-10">
  <div class="flex items-start justify-between gap-6">
    <div>
      <h2 class="font-display text-2xl font-bold sm:text-3xl">{paymentForm.name}</h2>
      <p class="mt-2 max-w-lg text-[0.92rem] text-ink-muted">
        Pay an invoice, deposit or service call securely. You will be taken to our payment
        provider to enter card details - we never handle or store them ourselves.
      </p>
    </div>
    <span class="hidden shrink-0 items-center gap-2 rounded-full border border-signal-500/30 bg-signal-500/10 px-3.5 py-2 text-[0.75rem] font-semibold text-signal-300 sm:flex">
      <Icon name="lock" size={14} /> Secure checkout
    </span>
  </div>

  <form id="payment-form" class="mt-8" novalidate data-submit-url={paymentForm.submitUrl}>
    <div class="grid gap-5 sm:grid-cols-2">
      <Field
        name="reason"
        label="What is this payment for?"
        type="select"
        required={isRequired(PAYMENT_FIELDS.reason)}
        options={reasonOptions}
        placeholder="Choose one"
        class="sm:col-span-2"
      />

      <Field
        name="invoiceNumber"
        label="Invoice or job number"
        required={isRequired(PAYMENT_FIELDS.invoiceNumber)}
        placeholder="INV-10482"
        hint="If you do not have one, enter the property address or the job we quoted."
      />

      {
        amountIsPayerChosen ? (
          <div data-field class="group">
            <label
              for="pay-amount"
              class="mb-2 block font-display text-[0.8rem] font-semibold tracking-wide text-ink-muted"
            >
              {amountLabel}
              <span class="ml-1 text-gold-400" aria-hidden="true">*</span>
            </label>
            <div class="relative">
              <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 font-display text-[0.95rem] text-ink-faint">
                $
              </span>
              <input
                id="pay-amount"
                name="amount"
                type="number"
                min={minimumAmount}
                step="0.01"
                required
                inputmode="decimal"
                placeholder="0.00"
                data-label="Amount"
                data-min-amount={minimumAmount}
                class="w-full rounded-2xl border border-white/12 bg-navy-900/60 py-3.5 pl-8 pr-4 text-[0.95rem] text-ink placeholder:text-ink-faint/70 transition-colors hover:border-white/20 focus:border-brand-400/70 focus:outline-none focus:ring-2 focus:ring-brand-500/25"
              />
            </div>
            <p class="mt-1.5 text-[0.78rem] text-ink-faint">
              Minimum ${minimumAmount.toFixed(2)}.
            </p>
            <p data-error class="mt-1.5 hidden text-[0.8rem] text-red-300"></p>
          </div>
        ) : (
          <div class="flex flex-col justify-end">
            <p class="font-display text-[0.8rem] font-semibold tracking-wide text-ink-muted">Amount</p>
            <p class="mt-2 font-display text-2xl font-bold text-gold-400">
              ${fixedAmount?.toFixed(2)}
            </p>
          </div>
        )
      }

      <Field
        name="name"
        label="Name on the account"
        required={isRequired(PAYMENT_FIELDS.name)}
        autocomplete="name"
      />
      <Field
        name="email"
        label="Email for receipt"
        type="email"
        required={isRequired(PAYMENT_FIELDS.email)}
        autocomplete="email"
      />
      <Field
        name="note"
        label="Note (optional)"
        type="textarea"
        rows={3}
        required={isRequired(PAYMENT_FIELDS.note)}
        class="sm:col-span-2"
        placeholder="Anything our accounts team should know about this payment."
      />
    </div>

    <!-- Honeypot. Tweeble rejects a submission where this is filled in. -->
    <div class="gg-honeypot" aria-hidden="true">
      <label>
        Do not fill this in
        <input type="text" name="website_url" data-honeypot tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <div id="payment-status" class="hidden"></div>

    <button
      type="submit"
      id="payment-submit"
      class="mt-7 inline-flex w-full items-center justify-center gap-2.5 rounded-full bg-gradient-to-r from-gold-500 to-gold-400 px-8 py-4 font-display text-base font-semibold text-navy-950 transition-all hover:-translate-y-0.5 hover:shadow-[0_16px_46px_-12px_rgba(248,184,40,.95)] disabled:pointer-events-none disabled:opacity-50 sm:w-auto"
    >
      <Icon name="credit-card" size={19} />
      {paymentForm.submitLabel}
    </button>

    <p class="mt-4 flex items-center gap-2 text-[0.78rem] text-ink-faint">
      <Icon name="shield-check" size={15} class="text-signal-400" />
      Card details are entered on our payment provider's hosted page, never on this site.
    </p>
  </form>
</div>

<script is:inline define:vars={{ FIELD_IDS: PAYMENT_FIELDS, MIN_AMOUNT: minimumAmount, PAYER_CHOOSES_AMOUNT: amountIsPayerChosen }}>
  (function () {
    const form = document.getElementById('payment-form');
    if (!form) return;
    const statusBox = document.getElementById('payment-status');
    const submit = document.getElementById('payment-submit');

    function show(kind, title, body) {
      if (!statusBox) return;
      const palette = {
        success: 'border-signal-500/40 bg-signal-500/10 text-signal-300',
        error: 'border-red-400/40 bg-red-500/10 text-red-200',
        info: 'border-gold-500/40 bg-gold-500/10 text-gold-200',
      };
      statusBox.className = 'mt-6 rounded-2xl border px-5 py-4 text-sm ' + palette[kind];
      statusBox.innerHTML = '';
      const h = document.createElement('p');
      h.className = 'font-display font-semibold';
      h.textContent = title;
      statusBox.appendChild(h);
      if (body) {
        const p = document.createElement('p');
        p.className = 'mt-1 leading-relaxed opacity-90';
        p.textContent = body;
        statusBox.appendChild(p);
      }
      statusBox.setAttribute('role', kind === 'error' ? 'alert' : 'status');
    }

    function setFieldError(input, message) {
      const wrap = input.closest('[data-field]');
      const target = wrap ? wrap.querySelector('[data-error]') : null;
      if (target) {
        target.textContent = message || '';
        target.classList.toggle('hidden', !message);
      }
      if (wrap) wrap.classList.toggle('is-invalid', Boolean(message));
      if (message) input.setAttribute('aria-invalid', 'true');
      else input.removeAttribute('aria-invalid');
    }

    function validate() {
      let firstInvalid = null;
      const controls = form.querySelectorAll('[name]:not([data-honeypot])');
      controls.forEach(function (el) {
        const value = (el.value || '').trim();
        let message = null;

        if (el.hasAttribute('required') && !value) {
          message = (el.dataset.label || 'This field') + ' is required.';
        } else if (el.getAttribute('type') === 'email' && value && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(value)) {
          message = 'Enter a valid email address.';
        } else if (el.name === 'amount' && PAYER_CHOOSES_AMOUNT) {
          const amount = Number(value);
          if (!Number.isFinite(amount) || amount < MIN_AMOUNT) {
            message = 'Enter an amount of at least $' + MIN_AMOUNT.toFixed(2) + '.';
          }
        }

        setFieldError(el, message);
        if (message && !firstInvalid) firstInvalid = el;
      });
      return firstInvalid;
    }

    form.querySelectorAll('[name]:not([data-honeypot])').forEach(function (el) {
      el.addEventListener('input', function () {
        if (el.getAttribute('aria-invalid')) validate();
      });
    });

    form.addEventListener('submit', async function (event) {
      event.preventDefault();

      const firstInvalid = validate();
      if (firstInvalid) {
        firstInvalid.focus();
        show('error', 'Check the highlighted fields', 'A few details are needed before we can start checkout.');
        return;
      }

      const read = (name) => {
        const el = form.querySelector('[name="' + name + '"]');
        return el ? el.value.trim() : '';
      };

      // Shape required by Tweeble: field ids as keys, amount in dollars.
      const payload = {
        [FIELD_IDS.reason]: read('reason'),
        [FIELD_IDS.invoiceNumber]: read('invoiceNumber'),
        [FIELD_IDS.name]: read('name'),
        [FIELD_IDS.email]: read('email'),
        [FIELD_IDS.note]: read('note'),
        website_url: read('website_url'),
        sourceUrl: window.location.href,
      };
      if (PAYER_CHOOSES_AMOUNT) payload.amount = Number(read('amount'));

      if (submit) submit.disabled = true;
      show('info', 'Starting secure checkout...', 'One moment while we prepare your payment.');

      try {
        const response = await fetch(form.dataset.submitUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await response.json().catch(function () {
          return {};
        });

        if (response.ok && result.checkoutUrl) {
          window.location.assign(result.checkoutUrl);
          return;
        }

        // Tweeble returns payer-appropriate messages, so show them as given.
        show(
          'error',
          'We could not start checkout',
          result.error || 'Something went wrong preparing your payment. Please try again, or call us.'
        );
      } catch (error) {
        show(
          'error',
          'We could not reach the payment service',
          'Check your connection and try again. If it persists, please call us and we will take payment over the phone.'
        );
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  })();
</script>
