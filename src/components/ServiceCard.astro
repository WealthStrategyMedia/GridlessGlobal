---
import Icon from './Icon.astro';
import { ACCENTS, type Service } from '~/data/services';

interface Props {
  service: Service;
  index?: number;
  /** Compact variant used in dense rails. */
  compact?: boolean;
  class?: string;
}

const { service, index = 0, compact = false, class: className = '' } = Astro.props;
const accent = ACCENTS[service.accent];
---
<a
  href={`/services/${service.slug}`}
  class={`group panel panel-hover reveal flex flex-col rounded-3xl ${compact ? 'p-5' : 'p-6'} ${className}`}
  style={`--reveal-delay:${Math.min(index, 8) * 60}ms`}
>
  <span
    class={`flex ${compact ? 'h-11 w-11' : 'h-[3.25rem] w-[3.25rem]'} items-center justify-center rounded-2xl border ${accent.border} ${accent.bg} ${accent.text} transition-transform duration-500 ease-[cubic-bezier(.16,1,.3,1)] group-hover:-translate-y-0.5 group-hover:scale-105`}
  >
    <Icon name={service.icon} size={compact ? 20 : 24} />
  </span>

  <h3
    class={`mt-4 font-display ${compact ? 'text-[1.02rem]' : 'text-[1.15rem]'} font-bold leading-snug text-ink transition-colors group-hover:text-white`}
  >
    {service.title}
  </h3>

  <p class={`mt-2 flex-1 ${compact ? 'text-[0.83rem]' : 'text-[0.88rem]'} leading-relaxed text-ink-muted`}>
    {compact ? service.summary.split(' - ')[0] : service.summary}
  </p>

  <span
    class={`mt-5 inline-flex items-center gap-2 font-display text-[0.82rem] font-semibold ${accent.text}`}
  >
    View services
    <Icon
      name="arrow-right"
      size={15}
      class="transition-transform duration-300 group-hover:translate-x-1"
    />
  </span>
</a>

