---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { site } from '~/data/site';

interface Props {
  title?: string;
  body?: string;
  primaryLabel?: string;
  primaryHref?: string;
  class?: string;
}

const {
  title = 'Let us start with the numbers',
  body = 'A measured energy analysis tells you which improvements actually pay, and in what order. It is the cheapest thing we do and the most useful place to begin.',
  primaryLabel = 'Book a free consultation',
  primaryHref = '/quote',
  class: className = '',
} = Astro.props;
---
<section class={`shell ${className}`}>
  <div class="aurora relative overflow-hidden rounded-4xl border border-white/10 bg-navy-900/60 px-7 py-14 sm:px-12 lg:px-16 lg:py-20">
    <div
      class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-signal-500/15 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -bottom-32 -left-20 h-80 w-80 rounded-full bg-brand-500/15 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="relative grid gap-10 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] lg:items-center">
      <div>
        <p class="eyebrow">Next step</p>
        <h2 class="mt-3 max-w-2xl font-display text-3xl font-bold leading-tight sm:text-4xl lg:text-5xl">
          {title}
        </h2>
        <p class="mt-5 max-w-xl text-[1.02rem] leading-relaxed text-ink-muted">{body}</p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href={primaryHref} variant="gold" size="lg" icon="arrow-right">{primaryLabel}</Button>
          <Button href={site.phoneHref} variant="outline" size="lg" icon="phone" iconPosition="start">
            {site.phone}
          </Button>
        </div>
      </div>

      <ul class="space-y-4 lg:justify-self-end">
        {
          [
            'No-obligation consultation and budget guidance',
            'Independent - we answer to you, not to a contractor',
            'Incentives handled, permits tracked for you',
            'Warranty paperwork collected and registered in your name',
          ].map((point) => (
            <li class="flex items-start gap-3 text-[0.93rem] text-ink-muted">
              <Icon name="check-circle" size={20} class="mt-px shrink-0 text-signal-400" />
              {point}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
