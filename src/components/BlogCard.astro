---
import Icon from './Icon.astro';
import type { BlogPost } from '~/lib/blog';

interface Props {
  post: BlogPost;
  index?: number;
}

const { post, index = 0 } = Astro.props;
const external = Boolean(post.url);
---
<article
  class="group reveal flex h-full flex-col overflow-hidden rounded-3xl border border-white/[0.09] bg-navy-900/55 transition-all duration-500 ease-[cubic-bezier(.16,1,.3,1)] hover:-translate-y-1.5 hover:border-brand-400/40 hover:bg-navy-850/70 hover:shadow-[0_28px_70px_-28px_rgba(1,11,22,1)]"
  style={`--reveal-delay:${Math.min(index, 8) * 70}ms`}
>
  <!-- Cover -->
  <div class="relative aspect-[16/10] w-full overflow-hidden bg-gradient-to-br from-navy-800 to-navy-950">
    {
      post.image ? (
        <img
          src={post.image}
          alt={post.imageAlt || ''}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-[900ms] ease-[cubic-bezier(.16,1,.3,1)] group-hover:scale-[1.06]"
        />
      ) : (
        /* No cover supplied: a branded placeholder beats a broken image. */
        <div class="flex h-full w-full items-center justify-center">
          <img
            src="/images/logo-mark.png"
            alt=""
            aria-hidden="true"
            width="280"
            height="248"
            loading="lazy"
            class="w-20 opacity-25 transition-opacity duration-500 group-hover:opacity-40"
          />
        </div>
      )
    }
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-t from-navy-900/70 via-transparent to-transparent"
      aria-hidden="true"
    >
    </div>
  </div>

  <!-- Body -->
  <div class="flex flex-1 flex-col p-6">
    <h3 class="font-display text-[1.18rem] font-bold leading-snug text-ink transition-colors group-hover:text-brand-200">
      {
        external ? (
          <a href={post.url} target="_blank" rel="noopener noreferrer" class="after:absolute after:inset-0">
            {post.title}
          </a>
        ) : (
          post.title
        )
      }
    </h3>

    {post.excerpt && <p class="mt-3 flex-1 text-[0.89rem] leading-relaxed text-ink-muted">{post.excerpt}</p>}

    <div class="rule mt-6"></div>

    <div class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-[0.78rem] text-ink-faint">
      {post.author && <span class="font-medium text-ink-muted">{post.author}</span>}
      {post.author && post.dateLabel && <span aria-hidden="true">&middot;</span>}
      {post.dateLabel && <time datetime={post.date ?? undefined}>{post.dateLabel}</time>}
      {
        external && (
          <span class="ml-auto flex items-center gap-1.5 font-display font-semibold text-brand-300 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
            Read
            <Icon name="arrow-up-right" size={14} />
          </span>
        )
      }
    </div>
  </div>
</article>

<style>
  /* The title link is stretched over the whole card, so the card body needs a
     positioning context for it. */
  article { position: relative; }
</style>
