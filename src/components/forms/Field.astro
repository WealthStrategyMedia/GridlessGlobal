---
/**
 * One labelled form control, with the markup the shared form runtime expects:
 * a `[data-field]` wrapper and a `[data-error]` message target.
 */
interface Props {
  name: string;
  label: string;
  type?: 'text' | 'email' | 'tel' | 'number' | 'date' | 'textarea' | 'select' | 'checkbox';
  required?: boolean;
  placeholder?: string;
  hint?: string;
  rows?: number;
  options?: { value: string; label: string }[];
  autocomplete?: string;
  inputmode?: 'text' | 'tel' | 'email' | 'numeric' | 'decimal';
  min?: string | number;
  step?: string | number;
  value?: string;
  minLength?: number;
  class?: string;
}

const {
  name,
  label,
  type = 'text',
  required = false,
  placeholder,
  hint,
  rows = 5,
  options = [],
  autocomplete,
  inputmode,
  min,
  step,
  value,
  minLength,
  class: className = '',
} = Astro.props;

const id = `f-${name}-${Math.random().toString(36).slice(2, 8)}`;
const errorId = `${id}-error`;

const control =
  'w-full rounded-2xl border border-white/12 bg-navy-900/60 px-4 py-3.5 text-[0.95rem] text-ink placeholder:text-ink-faint/70 transition-colors duration-200 hover:border-white/20 focus:border-brand-400/70 focus:bg-navy-900/90 focus:outline-none focus:ring-2 focus:ring-brand-500/25';
---
{
  type === 'checkbox' ? (
    <div data-field class={`group ${className}`}>
      <label class="flex cursor-pointer items-start gap-3 text-[0.88rem] leading-relaxed text-ink-muted">
        <input
          id={id}
          name={name}
          type="checkbox"
          required={required}
          data-label={label}
          class="mt-0.5 h-5 w-5 shrink-0 cursor-pointer rounded-md border border-white/20 bg-navy-900/60 accent-brand-500"
        />
        <span><slot>{label}</slot></span>
      </label>
      <p id={errorId} data-error class="mt-1.5 hidden text-[0.8rem] text-red-300" />
    </div>
  ) : (
    <div data-field class={`group ${className}`}>
      <label for={id} class="mb-2 block font-display text-[0.8rem] font-semibold tracking-wide text-ink-muted">
        {label}
        {required && <span class="ml-1 text-gold-400" aria-hidden="true">*</span>}
      </label>

      {type === 'textarea' ? (
        <textarea
          id={id}
          name={name}
          rows={rows}
          required={required}
          placeholder={placeholder}
          data-label={label}
          data-min-length={minLength}
          class={`${control} resize-y`}
        />
      ) : type === 'select' ? (
        <div class="relative">
          <select id={id} name={name} required={required} data-label={label} class={`${control} appearance-none pr-11`}>
            <option value="">{placeholder ?? 'Please select...'}</option>
            {/* A select is preselected via `selected` on the option - unlike an
                input, the `value` prop has no effect here. */}
            {options.map((o) => (
              <option value={o.value} selected={value != null && value === o.value}>
                {o.label}
              </option>
            ))}
          </select>
          <svg
            class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-ink-faint"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6" />
          </svg>
        </div>
      ) : (
        <input
          id={id}
          name={name}
          type={type}
          required={required}
          placeholder={placeholder}
          autocomplete={autocomplete}
          inputmode={inputmode}
          min={min}
          step={step}
          value={value}
          data-label={label}
          data-min-length={minLength}
          class={control}
        />
      )}

      {hint && <p class="mt-1.5 text-[0.78rem] text-ink-faint">{hint}</p>}
      <p id={errorId} data-error class="mt-1.5 hidden text-[0.8rem] text-red-300" />
    </div>
  )
}

<style>
  :global([data-field].is-invalid input),
  :global([data-field].is-invalid textarea),
  :global([data-field].is-invalid select) {
    border-color: rgb(248 113 113 / 0.6);
    background-color: rgb(127 29 29 / 0.12);
  }
</style>
