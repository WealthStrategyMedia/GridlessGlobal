---
import Icon from './Icon.astro';

/**
 * Two-step purchase flow shared by tickets and sponsorship packages.
 *
 * Step 1 gathers quantity (tickets only) and buyer details. Step 2 hands over
 * to Tweeble's hosted card form inside the same modal, exactly as the Pay a
 * Bill flow does, so the buyer never leaves the site. Tweeble signals the
 * outcome with a postMessage, which is accepted only from its own origin.
 */
---
<div
  id="event-purchase-modal"
  class="fixed inset-0 z-[60] hidden items-center justify-center p-0 sm:p-6"
  role="dialog"
  aria-modal="true"
  aria-labelledby="event-purchase-title"
>
  <div class="absolute inset-0 bg-navy-950/85 backdrop-blur-sm" data-ep-backdrop></div>

  <div class="panel relative flex h-full w-full max-w-2xl flex-col overflow-hidden rounded-none sm:h-auto sm:max-h-[94vh] sm:rounded-4xl">
    <!-- Header -->
    <div class="flex shrink-0 items-center justify-between gap-4 border-b border-white/[0.08] px-5 py-4 sm:px-7">
      <div class="flex min-w-0 items-center gap-3.5">
        <img src="/images/logo-mark.png" alt="" aria-hidden="true" width="280" height="265" class="h-10 w-10 shrink-0 object-contain" />
        <div class="min-w-0">
          <p id="event-purchase-title" class="truncate font-display text-[1rem] font-bold text-ink" data-ep-title>
            Secure purchase
          </p>
          <p class="mt-0.5 truncate text-[0.78rem] text-ink-faint" data-ep-subtitle></p>
        </div>
      </div>
      <button
        type="button"
        data-ep-close
        aria-label="Close"
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/15 text-ink-muted transition-colors hover:border-red-400/50 hover:text-ink"
      >
        <Icon name="close" size={19} />
      </button>
    </div>

    <!-- Step 1: details -->
    <div class="min-h-0 flex-1 overflow-y-auto px-5 py-6 sm:px-7" data-ep-step="details">
      <form data-ep-form novalidate>
        <!-- Quantity, tickets only -->
        <div data-ep-quantity-block class="hidden">
          <p class="font-display text-[0.8rem] font-semibold tracking-wide text-ink-muted">Quantity</p>
          <div class="mt-2.5 flex items-center gap-4">
            <div class="flex items-center gap-1 rounded-full border border-white/12 bg-navy-900/60 p-1">
              <button
                type="button"
                data-ep-step-down
                aria-label="Decrease quantity"
                class="flex h-10 w-10 items-center justify-center rounded-full text-ink-muted transition-colors hover:bg-white/[0.07] hover:text-ink disabled:opacity-40"
              >
                <Icon name="minus" size={18} />
              </button>
              <input
                type="number"
                name="quantity"
                value="1"
                min="1"
                max="10"
                inputmode="numeric"
                data-ep-quantity
                aria-label="Quantity"
                class="w-14 border-0 bg-transparent text-center font-display text-lg font-bold text-ink focus:outline-none [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
              />
              <button
                type="button"
                data-ep-step-up
                aria-label="Increase quantity"
                class="flex h-10 w-10 items-center justify-center rounded-full text-ink-muted transition-colors hover:bg-white/[0.07] hover:text-ink disabled:opacity-40"
              >
                <Icon name="plus" size={18} />
              </button>
            </div>
            <p class="text-[0.82rem] text-ink-faint" data-ep-unit></p>
          </div>
          <p class="mt-2 text-[0.78rem] text-ink-faint" data-ep-max-note></p>
        </div>

        <!-- Running total -->
        <div class="mt-6 flex items-baseline justify-between rounded-2xl border border-white/10 bg-white/[0.03] px-5 py-4">
          <span class="font-display text-[0.9rem] font-semibold text-ink-muted">Total</span>
          <span class="font-display text-2xl font-extrabold text-gold-400" data-ep-total>-</span>
        </div>

        <!-- Buyer details -->
        <div class="mt-6 grid gap-5 sm:grid-cols-2">
          <div data-field>
            <label for="ep-name" class="mb-2 block font-display text-[0.8rem] font-semibold tracking-wide text-ink-muted">
              Full name <span class="ml-1 text-gold-400" aria-hidden="true">*</span>
            </label>
            <input id="ep-name" name="name" type="text" required autocomplete="name" data-label="Full name"
              class="w-full rounded-2xl border border-white/12 bg-navy-900/60 px-4 py-3.5 text-[0.95rem] text-ink placeholder:text-ink-faint/70 transition-colors hover:border-white/20 focus:border-brand-400/70 focus:outline-none focus:ring-2 focus:ring-brand-500/25" />
            <p data-error class="mt-1.5 hidden text-[0.8rem] text-red-300"></p>
          </div>

          <div data-field>
            <label for="ep-email" class="mb-2 block font-display text-[0.8rem] font-semibold tracking-wide text-ink-muted">
              Email <span class="ml-1 text-gold-400" aria-hidden="true">*</span>
            </label>
            <input id="ep-email" name="email" type="email" required autocomplete="email" data-label="Email"
              class="w-full rounded-2xl border border-white/12 bg-navy-900/60 px-4 py-3.5 text-[0.95rem] text-ink placeholder:text-ink-faint/70 transition-colors hover:border-white/20 focus:border-brand-400/70 focus:outline-none focus:ring-2 focus:ring-brand-500/25" />
            <p data-error class="mt-1.5 hidden text-[0.8rem] text-red-300"></p>
          </div>

          <div data-field>
            <label for="ep-phone" class="mb-2 block font-display text-[0.8rem] font-semibold tracking-wide text-ink-muted">Phone</label>
            <input id="ep-phone" name="phone" type="tel" autocomplete="tel" data-label="Phone"
              class="w-full rounded-2xl border border-white/12 bg-navy-900/60 px-4 py-3.5 text-[0.95rem] text-ink placeholder:text-ink-faint/70 transition-colors hover:border-white/20 focus:border-brand-400/70 focus:outline-none focus:ring-2 focus:ring-brand-500/25" />
            <p data-error class="mt-1.5 hidden text-[0.8rem] text-red-300"></p>
          </div>

          <div data-field data-ep-company-block>
            <label for="ep-company" class="mb-2 block font-display text-[0.8rem] font-semibold tracking-wide text-ink-muted">
              Organisation <span data-ep-company-required class="ml-1 hidden text-gold-400" aria-hidden="true">*</span>
            </label>
            <input id="ep-company" name="company" type="text" autocomplete="organization" data-label="Organisation"
              class="w-full rounded-2xl border border-white/12 bg-navy-900/60 px-4 py-3.5 text-[0.95rem] text-ink placeholder:text-ink-faint/70 transition-colors hover:border-white/20 focus:border-brand-400/70 focus:outline-none focus:ring-2 focus:ring-brand-500/25" />
            <p data-error class="mt-1.5 hidden text-[0.8rem] text-red-300"></p>
          </div>

          <div data-field class="sm:col-span-2">
            <label for="ep-notes" class="mb-2 block font-display text-[0.8rem] font-semibold tracking-wide text-ink-muted">
              Notes (optional)
            </label>
            <textarea id="ep-notes" name="notes" rows="3" data-label="Notes"
              placeholder="Accessibility needs, dietary requirements, attendee names, or anything else we should know."
              class="w-full resize-y rounded-2xl border border-white/12 bg-navy-900/60 px-4 py-3.5 text-[0.95rem] text-ink placeholder:text-ink-faint/70 transition-colors hover:border-white/20 focus:border-brand-400/70 focus:outline-none focus:ring-2 focus:ring-brand-500/25"></textarea>
            <p data-error class="mt-1.5 hidden text-[0.8rem] text-red-300"></p>
          </div>
        </div>

        <div class="gg-honeypot" aria-hidden="true">
          <input type="text" name="website_url" data-honeypot tabindex="-1" autocomplete="off" />
        </div>

        <div data-ep-status class="hidden"></div>

        <button
          type="submit"
          data-ep-submit
          class="mt-7 inline-flex w-full items-center justify-center gap-2.5 rounded-full bg-gradient-to-r from-gold-500 to-gold-400 px-8 py-4 font-display text-base font-semibold text-navy-950 transition-all hover:-translate-y-0.5 hover:shadow-[0_16px_46px_-12px_rgba(248,184,40,.95)] disabled:pointer-events-none disabled:opacity-50"
        >
          <Icon name="credit-card" size={19} />
          <span data-ep-submit-text>Continue to payment</span>
        </button>

        <p class="mt-4 flex items-center gap-2 text-[0.78rem] text-ink-faint">
          <Icon name="shield-check" size={15} class="text-signal-400" />
          Card details are entered on our payment provider's secure form, never on this site.
        </p>
      </form>
    </div>

    <!-- Step 2: payment -->
    <div class="relative hidden min-h-0 flex-1 bg-white" data-ep-step="payment" data-ep-frame-slot>
      <div class="absolute inset-0 flex flex-col items-center justify-center gap-4 bg-navy-900" data-ep-loading>
        <span class="gg-spinner" aria-hidden="true">
          <img src="/images/logo-mark.png" alt="" width="280" height="265" />
        </span>
        <p class="font-display text-[0.9rem] font-semibold text-ink">Opening secure payment...</p>
      </div>

      <div class="absolute inset-x-0 bottom-0 hidden border-t border-gold-500/30 bg-navy-950/97 px-5 py-4 sm:px-7" data-ep-stalled role="status">
        <p class="flex items-start gap-2.5 font-display text-[0.88rem] font-semibold text-gold-300">
          <Icon name="alert" size={17} class="mt-px shrink-0" />
          The card form is taking longer than usual
        </p>
        <p class="mt-1.5 text-[0.82rem] leading-relaxed text-ink-muted">
          Nothing has been charged. Open it in its own tab to finish, or close and try again shortly.
        </p>
        <div class="mt-3.5 flex flex-wrap gap-2.5">
          <button type="button" data-ep-newtab
            class="inline-flex items-center gap-2 rounded-full bg-gradient-to-r from-gold-500 to-gold-400 px-5 py-2.5 font-display text-[0.82rem] font-semibold text-navy-950 transition-transform hover:-translate-y-0.5">
            Open in a new tab <Icon name="arrow-up-right" size={15} />
          </button>
          <button type="button" data-ep-reload
            class="inline-flex items-center gap-2 rounded-full border border-white/20 px-5 py-2.5 font-display text-[0.82rem] font-semibold text-ink transition-colors hover:border-brand-400/60">
            Reload
          </button>
        </div>
      </div>
    </div>

    <!-- Step 3: done -->
    <div class="hidden min-h-0 flex-1 overflow-y-auto px-5 py-10 text-center sm:px-7" data-ep-step="done" tabindex="-1">
      <span class="mx-auto flex h-20 w-20 items-center justify-center rounded-full border border-signal-500/40 bg-signal-500/12 text-signal-400">
        <Icon name="check-circle" size={40} />
      </span>
      <h3 class="mt-7 font-display text-2xl font-bold">Thank you - you are all set</h3>
      <p class="mx-auto mt-3 max-w-md text-[0.95rem] leading-relaxed text-ink-muted">
        A confirmation is on its way to the email address you gave us. Please keep it - it is your
        record of purchase.
      </p>
      <div class="mx-auto mt-6 hidden max-w-md rounded-2xl border border-white/10 bg-white/[0.03] px-5 py-4 text-left" data-ep-reference>
        <p class="text-[0.72rem] uppercase tracking-wider text-ink-faint">Reference</p>
        <p class="mt-1 break-all font-mono text-[0.82rem] text-ink" data-ep-reference-value></p>
      </div>
      <button type="button" data-ep-close
        class="mt-8 inline-flex items-center gap-2.5 rounded-full border border-white/20 px-6 py-3 font-display text-[0.88rem] font-semibold text-ink transition-colors hover:border-brand-400/60">
        Close
      </button>
    </div>

    <!-- Footer -->
    <div class="flex shrink-0 flex-wrap items-center justify-between gap-3 border-t border-white/[0.08] px-5 py-3.5 text-[0.76rem] text-ink-faint sm:px-7">
      <span class="flex items-center gap-2">
        <Icon name="lock" size={14} class="text-signal-400" />
        Encrypted - your card is handled by our payment provider
      </span>
      <span class="flex items-center gap-1.5">
        Payments powered by
        <a href="https://tweeble.com" target="_blank" rel="noopener noreferrer"
          class="font-semibold text-brand-300 underline underline-offset-2 hover:text-brand-200">Tweeble</a>
      </span>
    </div>
  </div>
</div>
