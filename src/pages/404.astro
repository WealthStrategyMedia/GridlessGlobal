---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Button from '~/components/Button.astro';
import Icon from '~/components/Icon.astro';
import { pillarServices } from '~/data/services';
---
<BaseLayout
  title="Page Not Found"
  description="That page could not be found. Browse the Gridless Global services map or head back to the home page."
  noindex
>
  <section class="aurora grid-lines relative">
    <div class="shell flex min-h-[72vh] flex-col items-center justify-center py-20 text-center">
      <p class="font-display text-[5rem] font-extrabold leading-none text-gradient sm:text-[8rem]">404</p>
      <h1 class="mt-4 font-display text-3xl font-bold sm:text-4xl">This circuit goes nowhere</h1>
      <p class="mt-5 max-w-xl text-[1.02rem] leading-relaxed text-ink-muted">
        The page you were after has moved or never existed. Here are the routes that definitely work.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <Button href="/" variant="gold" size="lg" icon="arrow-right">Back to home</Button>
        <Button href="/services" variant="outline" size="lg" icon="search" iconPosition="start">
          Browse all services
        </Button>
      </div>

      <div class="mt-16 w-full max-w-5xl">
        <p class="eyebrow">Popular services</p>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {
            pillarServices.slice(0, 6).map((service) => (
              <li>
                <a
                  href={`/services/${service.slug}`}
                  class="group flex items-center gap-3.5 rounded-2xl border border-white/10 bg-white/[0.03] px-5 py-4 text-left transition-all hover:-translate-y-0.5 hover:border-brand-400/40"
                >
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white/[0.06] text-brand-300">
                    <Icon name={service.icon} size={19} />
                  </span>
                  <span class="flex-1 font-display text-[0.9rem] font-semibold text-ink">
                    {service.title}
                  </span>
                  <Icon
                    name="arrow-right"
                    size={16}
                    class="shrink-0 text-ink-faint transition-transform group-hover:translate-x-1"
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
