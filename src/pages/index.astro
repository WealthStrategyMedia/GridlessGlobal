---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ServicesMap from '~/components/ServicesMap.astro';
import SpinningGlobe from '~/components/SpinningGlobe.astro';
import FreeOffer from '~/components/FreeOffer.astro';
import Button from '~/components/Button.astro';
import Icon from '~/components/Icon.astro';
import Faq from '~/components/Faq.astro';
import CtaBand from '~/components/CtaBand.astro';
import { site } from '~/data/site';
import { requireService } from '~/data/services';
import type { IconName } from '~/components/icons';

const heroStats = [
  { value: '25+', label: 'Project types supported' },
  { value: '5 kW-10,000 MW', label: 'Project scale supported' },
  { value: '1', label: 'Organized project record' },
  { value: 'Owner-side', label: 'Always on your side of the table' },
];

const differentiators: { icon: IconName; title: string; body: string }[] = [
  {
    icon: 'file-text',
    title: 'Project clarity',
    body: 'Know what has been proposed, what decisions are still open, which documents are missing and what happens next. One organized picture instead of forty emails and a folder of PDFs.',
  },
  {
    icon: 'network',
    title: 'Provider coordination',
    body: 'Keep communications with contractors, engineers, vendors and everyone else on the project flowing through one owner-side process, so nothing depends on you remembering to forward it.',
  },
  {
    icon: 'gauge',
    title: 'Budget and milestone visibility',
    body: 'Track project budgets, invoices and contractor-reported milestones without living inside spreadsheets, text threads and email chains.',
  },
  {
    icon: 'shield-check',
    title: 'Documented from start to closeout',
    body: 'Scopes, proposals, permits, decisions, warranty records, equipment documents and closeout paperwork organized and handed to you, not scattered across four companies.',
  },
  {
    icon: 'users',
    title: 'One owner-side point of coordination',
    body: 'Instead of personally chasing every participant, you work through one organized Gridless process. Contractors and licensed professionals stay responsible for their regulated work; we keep you informed and the project information connected.',
  },
  {
    icon: 'leaf',
    title: 'Not another trade selling you its piece',
    body: 'Our fee buys judgement, not a product line. Contractors see their scope. Gridless helps you see the project - which sometimes means telling you not to buy the thing you asked about.',
  },
];

const process = [
  { step: 'Understand', body: 'We organize your goals, documentation, constraints, priorities and the outcome you are actually after.' },
  { step: 'Build the picture', body: 'An organized owner-side project record, so requirements, proposals, documents, open questions and decisions are visible in one place.' },
  { step: 'Coordinate', body: 'Where regulated services are required, you contract directly with appropriately licensed professionals. We coordinate the information and communication around those relationships.' },
  { step: 'Keep you informed', body: 'Documentation, budgets, communications, open decisions and contractor-reported milestones tracked, so you can see where the project stands.' },
  { step: 'Close out', body: 'Final documents, warranties, manuals, approvals and project records collected and organized for you.' },
];

const testimonials = [
  {
    quote:
      'They found two billing errors and a wrong rate schedule before they ever mentioned hardware. That alone covered the audit several times over.',
    name: 'Facilities Director',
    role: 'Regional manufacturing group',
  },
  {
    quote:
      'Roof replacement and solar detach on one schedule, with one person answering the phone and every document in one place. Before Gridless I was the one relaying messages between two contractors who blamed each other.',
    name: 'Homeowner',
    role: 'Residential solar and roofing',
  },
  {
    quote:
      'The microgrid islanded cleanly during a regional outage and the campus never noticed. The drills they insisted on beforehand are why.',
    name: 'Operations Lead',
    role: 'University campus',
  },
];

const homeFaqs = [
  {
    q: 'Is Gridless Global a contractor?',
    a: 'No. Gridless Global is an owner-side project advisory and administration company. Gridless does not itself perform regulated construction or trade work. Where contractor licensing is required, that work is performed under a separate agreement with an appropriately licensed contractor.',
  },
  {
    q: 'Then what does Gridless actually do?',
    a: 'We help you organize the project: requirements, documents, communications, commercial information, project records, open issues, budgets, decisions, provider information and closeout. The goal is one clear project picture, instead of piecing it together from scattered calls, texts and emails.',
  },
  {
    q: 'Do I still need licensed contractors?',
    a: 'Yes, whenever the work requires them. Gridless helps you navigate the project around those professionals; it does not replace legally required licensed providers.',
  },
  {
    q: 'Who pays the contractors?',
    a: 'Unless another lawful written arrangement applies, you contract with and pay third-party contractors and professionals directly. Gridless charges separately for its own advisory and project-administration services, so you can always see what you are paying us for.',
  },
  {
    q: 'Does Gridless supervise construction?',
    a: 'No. Gridless does not direct construction means and methods, control jobsite safety, or take on responsibilities assigned by law to a licensed contractor or owner-builder. We maintain project records, coordinate communications and track information reported by project participants, within the scope applicable law allows.',
  },
  {
    q: 'Can Gridless help with an insurance-related repair?',
    a: 'We can assist with ordinary project documentation and repair-project administration. Gridless is not a public adjuster and does not prepare, negotiate or settle insurance claims for compensation - that belongs with you, a licensed public adjuster or your attorney.',
  },
  {
    q: 'Can Gridless work anywhere?',
    a: 'Available services vary by jurisdiction, because contractor, engineering, owner-builder and professional licensing laws differ. We adjust our scope to the law applicable to each project, and we will tell you plainly where that changes what we can do.',
  },
];

const segments = [
  {
    slug: 'residential',
    label: 'For your home',
    points: ['Solar, battery and EV charging', 'Energy analysis and bill savings', 'Electrical, roofing and siding', 'Additions, remodels and repairs'],
  },
  {
    slug: 'commercial',
    label: 'For your business',
    points: ['Portfolio audits and benchmarking', 'Commercial solar and storage', 'Demand-charge and tariff work', 'Carbon credits and ESG reporting'],
  },
];
---
<BaseLayout
  title="Owner-Side Project Advisory for Energy, Roofing, Electrical & Construction"
  description={site.description}
>
  <!-- ================= Hero ================= -->
  <section class="aurora grid-lines relative overflow-hidden">
    <div class="shell relative pb-16 pt-14 lg:pb-24 lg:pt-20">
      <div class="grid items-center gap-14 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,.85fr)] lg:gap-16">
        <div>
          <p
            class="inline-flex items-center gap-2.5 rounded-full border border-signal-500/25 bg-signal-500/[0.08] px-4 py-2 text-[0.78rem] font-semibold tracking-wide text-signal-300"
          >
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-signal-400 opacity-70"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-signal-400"></span>
            </span>
            Owner-side project advisory, coordination &amp; administration
          </p>

          <h1 class="mt-7 font-display text-[2.6rem] font-extrabold leading-[1.04] sm:text-6xl xl:text-7xl">
            <span class="block">Your project.</span>
            <span class="text-gradient mt-1 block">One command center.</span>
          </h1>

          <p class="mt-7 max-w-2xl text-[1.08rem] leading-relaxed text-ink-muted lg:text-[1.18rem]">
            <strong class="font-semibold text-ink">You own the project. We help you stay in control of it.</strong>
            Gridless Global brings complex energy, roofing, electrical, construction and facility
            projects under control - organizing the information, providers, budgets, documentation,
            milestones and decisions into one owner-side process. Licensed specialists handle the
            regulated work. We help you keep the whole project organized, visible and moving.
          </p>

          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <Button href="/quote" variant="gold" size="lg" icon="arrow-right">Build my project plan</Button>
            <Button href="/contact" variant="outline" size="lg" icon="sparkles" iconPosition="start">
              Talk to a project advisor
            </Button>
          </div>

          <ul class="mt-10 flex flex-wrap gap-x-7 gap-y-3">
            {
              ['Owner-side, always', 'One organized record', 'Provider coordination', 'Full project visibility'].map((point) => (
                <li class="flex items-center gap-2 text-[0.85rem] text-ink-muted">
                  <Icon name="check" size={16} class="text-signal-400" />
                  {point}
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Hero visual: brand mark over a pillar stack -->
        <div class="relative lg:justify-self-end">
          <div
            class="pointer-events-none absolute left-1/2 top-1/2 h-[26rem] w-[26rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-500/12 blur-[90px]"
            aria-hidden="true"
          >
          </div>

          <SpinningGlobe class="mx-auto w-40 sm:w-52 lg:w-56" />

          <div class="panel relative mt-8 rounded-4xl p-6 sm:p-7">
            <p class="eyebrow">Headline capability</p>
            <ul class="mt-5 space-y-3.5">
              {
                ['residential', 'commercial', 'solar-power-plant', 'energy-storage', 'smart-microgrid'].map(
                  (slug, i) => {
                    const service = requireService(slug);
                    return (
                      <li>
                        <a
                          href={`/services/${slug}`}
                          class="group reveal flex items-center gap-4 rounded-2xl border border-white/8 bg-white/[0.03] px-4 py-3 transition-all duration-300 hover:-translate-y-0.5 hover:border-brand-400/40 hover:bg-white/[0.06]"
                          style={`--reveal-delay:${i * 70}ms`}
                        >
                          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white/[0.06] text-brand-300">
                            <Icon name={service.icon} size={19} />
                          </span>
                          <span class="flex-1 font-display text-[0.92rem] font-semibold text-ink">
                            {service.title}
                          </span>
                          <Icon
                            name="arrow-right"
                            size={16}
                            class="shrink-0 text-ink-faint transition-all group-hover:translate-x-1 group-hover:text-brand-300"
                          />
                        </a>
                      </li>
                    );
                  }
                )
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= Stats strip ================= -->
  <section class="border-y border-white/[0.07] bg-navy-900/40">
    <div class="shell grid grid-cols-2 divide-x divide-white/[0.07] lg:grid-cols-4">
      {
        heroStats.map((stat) => (
          <div class="px-4 py-8 text-center lg:py-10">
            <p class="font-display text-2xl font-extrabold text-ink sm:text-3xl lg:text-[2.1rem]">
              {stat.value}
            </p>
            <p class="mt-2 text-[0.8rem] leading-snug text-ink-faint sm:text-[0.85rem]">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ================= Free analysis / consultation ================= -->
  <FreeOffer class="pt-16 lg:pt-24" />

  <!-- ================= Services map ================= -->
  <div class="shell py-16 lg:py-20">
    <ServicesMap />
  </div>

  <!-- ================= Residential / Commercial ================= -->
  <section class="shell py-14 lg:py-20">
    <div class="mb-10">
      <p class="eyebrow">Two ways we work</p>
      <h2 class="mt-3 font-display text-3xl font-bold sm:text-4xl lg:text-5xl">
        Whether it is a house or a portfolio
      </h2>
      <p class="mt-4 max-w-2xl text-[1.02rem] leading-relaxed text-ink-muted">
        The same owner-side process, scaled to the property. Whichever route you come in through,
        you get one organized project record and one place the information lives.
      </p>
    </div>

    <div class="grid gap-6 lg:grid-cols-2">
      {
        segments.map((segment, i) => {
          const service = requireService(segment.slug);
          return (
            <a
              href={`/services/${segment.slug}`}
              class="group panel panel-hover reveal relative overflow-hidden rounded-4xl p-8 sm:p-10"
              style={`--reveal-delay:${i * 90}ms`}
            >
              <span
                class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-brand-500/10 blur-3xl transition-opacity duration-500 group-hover:opacity-150"
                aria-hidden="true"
              />
              <span class="relative flex h-14 w-14 items-center justify-center rounded-2xl border border-white/12 bg-white/[0.05] text-signal-400">
                <Icon name={service.icon} size={27} />
              </span>
              <p class="relative mt-6 eyebrow">{segment.label}</p>
              <h3 class="relative mt-2 font-display text-2xl font-bold sm:text-3xl">{service.title}</h3>
              <p class="relative mt-4 text-[0.95rem] leading-relaxed text-ink-muted">{service.summary}</p>

              <ul class="relative mt-7 grid gap-2.5 sm:grid-cols-2">
                {segment.points.map((point) => (
                  <li class="flex items-start gap-2.5 text-[0.87rem] text-ink-muted">
                    <Icon name="check" size={16} class="mt-0.5 shrink-0 text-signal-400" />
                    {point}
                  </li>
                ))}
              </ul>

              <span class="relative mt-8 inline-flex items-center gap-2 font-display text-[0.88rem] font-semibold text-gold-400">
                See everything included
                <Icon name="arrow-right" size={16} class="transition-transform group-hover:translate-x-1" />
              </span>
            </a>
          );
        })
      }
    </div>
  </section>

  <!-- ================= Why us ================= -->
  <section class="shell py-14 lg:py-20">
    <div class="mb-10 max-w-3xl">
      <p class="eyebrow">Why owners bring us in</p>
      <h2 class="mt-3 font-display text-3xl font-bold sm:text-4xl lg:text-5xl">
        You should not have to manage twenty moving parts yourself
      </h2>
      <p class="mt-4 text-[1.02rem] leading-relaxed text-ink-muted">
        A complex property or infrastructure project turns quickly into a maze of contractors,
        proposals, technical questions, permits, invoices, equipment, timelines, warranties and
        unanswered emails. Gridless gives you a central project layer for information,
        administration and decision support - so the moving parts become one clear picture.
      </p>
    </div>

    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {
        differentiators.map((item, i) => (
          <article
            class="panel panel-hover reveal rounded-3xl p-7"
            style={`--reveal-delay:${Math.min(i, 6) * 60}ms`}
          >
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl border border-signal-500/25 bg-signal-500/10 text-signal-400">
              <Icon name={item.icon} size={23} />
            </span>
            <h3 class="mt-5 font-display text-[1.15rem] font-bold">{item.title}</h3>
            <p class="mt-2.5 text-[0.9rem] leading-relaxed text-ink-muted">{item.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ================= Process ================= -->
  <section class="shell py-14 lg:py-20">
    <div class="panel overflow-hidden rounded-4xl p-8 sm:p-12 lg:p-16">
      <div class="max-w-2xl">
        <p class="eyebrow">How Gridless works</p>
        <h2 class="mt-3 font-display text-3xl font-bold sm:text-4xl">From first conversation to organized closeout</h2>
      </div>

      <ol class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-5 lg:gap-6">
        {
          process.map((item, i) => (
            <li class="reveal relative" style={`--reveal-delay:${i * 80}ms`}>
              {i < process.length - 1 && (
                <span
                  class="absolute left-[1.35rem] top-12 hidden h-[calc(100%-1rem)] w-px bg-gradient-to-b from-white/18 to-transparent sm:block lg:left-12 lg:top-[1.35rem] lg:h-px lg:w-[calc(100%-1rem)] lg:bg-gradient-to-r"
                  aria-hidden="true"
                />
              )}
              <span class="relative z-10 flex h-11 w-11 items-center justify-center rounded-full border border-gold-500/40 bg-navy-900 font-display text-[0.82rem] font-bold text-gold-400">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-5 font-display text-[1.05rem] font-bold">{item.step}</h3>
              <p class="mt-2 text-[0.88rem] leading-relaxed text-ink-muted">{item.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ================= Testimonials ================= -->
  <section class="shell py-14 lg:py-20">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="eyebrow">Project advisory in action</p>
        <h2 class="mt-3 font-display text-3xl font-bold sm:text-4xl">Projects Gridless helped organize</h2>
      </div>
      <Button href="/how-gridless-works" variant="outline" size="sm" icon="arrow-right">How our project model works</Button>
    </div>

    <div class="grid gap-5 lg:grid-cols-3">
      {
        testimonials.map((item, i) => (
          <figure class="panel reveal flex flex-col rounded-3xl p-7" style={`--reveal-delay:${i * 80}ms`}>
            <Icon name="quote" size={26} class="text-brand-400/70" />
            <blockquote class="mt-5 flex-1 text-[0.98rem] leading-relaxed text-ink">
              {item.quote}
            </blockquote>
            <figcaption class="mt-6 border-t border-white/8 pt-5">
              <p class="font-display text-[0.9rem] font-semibold text-ink">{item.name}</p>
              <p class="mt-0.5 text-[0.82rem] text-ink-faint">{item.role}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <!-- ================= FAQ ================= -->
  <section class="shell py-14 lg:py-20">
    <Faq items={homeFaqs} title="Questions worth asking first" eyebrow="Before you call" />
  </section>

  <CtaBand class="pb-8" />
</BaseLayout>
