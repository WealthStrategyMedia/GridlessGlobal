---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ServicesMap from '~/components/ServicesMap.astro';
import Button from '~/components/Button.astro';
import Icon from '~/components/Icon.astro';
import Faq from '~/components/Faq.astro';
import CtaBand from '~/components/CtaBand.astro';
import { site } from '~/data/site';
import { requireService } from '~/data/services';
import type { IconName } from '~/components/icons';

const heroStats = [
  { value: '25+', label: 'Services under one roof' },
  { value: '250 kW-200 MW', label: 'Projects delivered' },
  { value: '24/7', label: 'Emergency response' },
  { value: '1', label: 'Warranty across every trade' },
];

const differentiators: { icon: IconName; title: string; body: string }[] = [
  {
    icon: 'shield-check',
    title: 'We self-perform',
    body: 'Licensed electricians, roofers and builders on staff. Your schedule is not hostage to a subcontractor who stopped answering the phone.',
  },
  {
    icon: 'gauge',
    title: 'Measurement before sales',
    body: 'Every recommendation starts with metered data and a ranked payback list. Sometimes that means telling you not to buy the thing you asked about.',
  },
  {
    icon: 'network',
    title: 'The whole system',
    body: 'Generation, storage, controls, envelope and trades designed together, because optimising one in isolation usually wastes money on the others.',
  },
  {
    icon: 'file-text',
    title: 'Paperwork is our job',
    body: 'Permits, interconnection, incentives, rebates and grants are inside our scope. You sign; we file, chase and close them out.',
  },
  {
    icon: 'users',
    title: 'One accountable team',
    body: 'A single point of contact from the first site visit through commissioning and long after, with one warranty conversation, not four.',
  },
  {
    icon: 'leaf',
    title: 'Built to last decades',
    body: 'We design for thirty-year asset life and we are still here to service it, which shapes every specification decision we make.',
  },
];

const process = [
  { step: 'Consult', body: 'A real conversation about the property, the budget and what you are actually trying to solve.' },
  { step: 'Analyse', body: 'Metered data, site survey and tariff review establish what is true before anything is proposed.' },
  { step: 'Design', body: 'One integrated scope across every trade, priced transparently with the incentives already applied.' },
  { step: 'Build', body: 'Self-performed crews, managed permits and a sequence that keeps the site working.' },
  { step: 'Support', body: 'Monitoring, maintenance and one number to call for the life of the system.' },
];

const testimonials = [
  {
    quote:
      'They found two billing errors and a wrong rate schedule before they ever mentioned hardware. That alone covered the audit several times over.',
    name: 'Facilities Director',
    role: 'Regional manufacturing group',
  },
  {
    quote:
      'Roof replacement and solar detach in one project, one contract, one warranty. Every other quote had me managing two contractors who blamed each other.',
    name: 'Homeowner',
    role: 'Residential solar and roofing',
  },
  {
    quote:
      'The microgrid islanded cleanly during a regional outage and the campus never noticed. The drills they insisted on beforehand are why.',
    name: 'Operations Lead',
    role: 'University campus',
  },
];

const homeFaqs = [
  {
    q: 'What exactly does Gridless Global do?',
    a: 'We cover the energy space end to end. At utility scale that means developing, building and operating solar, hydro, thermal, storage and microgrid assets. For homes and businesses it means solar, batteries, EV charging, energy analysis, bill savings, carbon credits, grant writing - plus the electrical, roofing, siding, construction and handyman work that those projects depend on.',
  },
  {
    q: 'Do I have to buy a whole system?',
    a: 'No. A great many of our customers start with an energy analysis and act on the cheapest items first. Others come to us purely for roofing, electrical or grant writing and never install a panel. Take the parts that are useful.',
  },
  {
    q: 'How do you charge?',
    a: 'Consultations and project estimates are free. Energy audits carry a fee that we credit against implementation work on most residential projects. Construction and trades work is quoted fixed-price or hourly, agreed in writing before we start.',
  },
  {
    q: 'What areas do you serve?',
    a: 'Trades and residential work is regional; energy development, advisory and grant services are delivered nationally. Tell us where the property is and we will confirm coverage straight away.',
  },
  {
    q: 'Are you licensed and insured?',
    a: 'Yes. Our electricians are licensed, our crews are insured, and we carry the bonding that commercial and institutional clients require. Documentation is provided with every proposal.',
  },
];

const segments = [
  {
    slug: 'residential',
    label: 'For your home',
    points: ['Solar, battery and EV charging', 'Energy analysis and bill savings', 'Electrical, roofing and siding', 'Additions, remodels and repairs'],
  },
  {
    slug: 'commercial',
    label: 'For your business',
    points: ['Portfolio audits and benchmarking', 'Commercial solar and storage', 'Demand-charge and tariff work', 'Carbon credits and ESG reporting'],
  },
];
---
<BaseLayout
  title="Energy Generation, Solar, Electrical & Construction"
  description={site.description}
>
  <!-- ================= Hero ================= -->
  <section class="aurora grid-lines relative overflow-hidden">
    <div class="shell relative pb-16 pt-14 lg:pb-24 lg:pt-20">
      <div class="grid items-center gap-14 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,.85fr)] lg:gap-16">
        <div>
          <p
            class="inline-flex items-center gap-2.5 rounded-full border border-signal-500/25 bg-signal-500/[0.08] px-4 py-2 text-[0.78rem] font-semibold tracking-wide text-signal-300"
          >
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-signal-400 opacity-70"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-signal-400"></span>
            </span>
            Powering a Connected Future
          </p>

          <h1 class="mt-7 font-display text-[2.6rem] font-extrabold leading-[1.04] sm:text-6xl xl:text-7xl">
            <span class="block">The entire energy stack,</span>
            <span class="text-gradient mt-1 block">under one roof</span>
          </h1>

          <p class="mt-7 max-w-2xl text-[1.08rem] leading-relaxed text-ink-muted lg:text-[1.18rem]">
            Gridless Global builds and operates power - utility-scale solar, hydro, thermal, storage
            and microgrids - and brings the same engineering to homes and businesses: solar,
            electrical, roofing, construction and the analysis that shows which of them actually pays.
          </p>

          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <Button href="/quote" variant="gold" size="lg" icon="arrow-right">Get a free estimate</Button>
            <Button href="/services" variant="outline" size="lg" icon="sparkles" iconPosition="start">
              Explore the services map
            </Button>
          </div>

          <ul class="mt-10 flex flex-wrap gap-x-7 gap-y-3">
            {
              ['Licensed & insured', 'Self-performing crews', 'Incentives handled', 'One warranty'].map((point) => (
                <li class="flex items-center gap-2 text-[0.85rem] text-ink-muted">
                  <Icon name="check" size={16} class="text-signal-400" />
                  {point}
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Hero visual: brand mark over a pillar stack -->
        <div class="relative lg:justify-self-end">
          <div
            class="pointer-events-none absolute left-1/2 top-1/2 h-[26rem] w-[26rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-500/12 blur-[90px]"
            aria-hidden="true"
          >
          </div>

          <img
            src="/images/logo-mark.png"
            alt=""
            aria-hidden="true"
            width="280"
            height="248"
            class="animate-float mx-auto w-40 drop-shadow-[0_0_70px_rgba(63,208,106,.35)] sm:w-52 lg:w-56"
          />

          <div class="panel relative mt-8 rounded-4xl p-6 sm:p-7">
            <p class="eyebrow">Headline capability</p>
            <ul class="mt-5 space-y-3.5">
              {
                ['solar-power-plant', 'energy-storage', 'smart-microgrid', 'residential', 'commercial'].map(
                  (slug, i) => {
                    const service = requireService(slug);
                    return (
                      <li>
                        <a
                          href={`/services/${slug}`}
                          class="group reveal flex items-center gap-4 rounded-2xl border border-white/8 bg-white/[0.03] px-4 py-3 transition-all duration-300 hover:-translate-y-0.5 hover:border-brand-400/40 hover:bg-white/[0.06]"
                          style={`--reveal-delay:${i * 70}ms`}
                        >
                          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white/[0.06] text-brand-300">
                            <Icon name={service.icon} size={19} />
                          </span>
                          <span class="flex-1 font-display text-[0.92rem] font-semibold text-ink">
                            {service.title}
                          </span>
                          <Icon
                            name="arrow-right"
                            size={16}
                            class="shrink-0 text-ink-faint transition-all group-hover:translate-x-1 group-hover:text-brand-300"
                          />
                        </a>
                      </li>
                    );
                  }
                )
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= Stats strip ================= -->
  <section class="border-y border-white/[0.07] bg-navy-900/40">
    <div class="shell grid grid-cols-2 divide-x divide-white/[0.07] lg:grid-cols-4">
      {
        heroStats.map((stat) => (
          <div class="px-4 py-8 text-center lg:py-10">
            <p class="font-display text-2xl font-extrabold text-ink sm:text-3xl lg:text-[2.1rem]">
              {stat.value}
            </p>
            <p class="mt-2 text-[0.8rem] leading-snug text-ink-faint sm:text-[0.85rem]">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ================= Services map ================= -->
  <div class="shell py-16 lg:py-24">
    <ServicesMap />
  </div>

  <!-- ================= Residential / Commercial ================= -->
  <section class="shell py-14 lg:py-20">
    <div class="mb-10">
      <p class="eyebrow">Two ways we work</p>
      <h2 class="mt-3 font-display text-3xl font-bold sm:text-4xl lg:text-5xl">
        Whether it is a house or a portfolio
      </h2>
      <p class="mt-4 max-w-2xl text-[1.02rem] leading-relaxed text-ink-muted">
        The same capability, scaled to the property. Every energy service we offer is available to
        both, and the trades work is in-house either way.
      </p>
    </div>

    <div class="grid gap-6 lg:grid-cols-2">
      {
        segments.map((segment, i) => {
          const service = requireService(segment.slug);
          return (
            <a
              href={`/services/${segment.slug}`}
              class="group panel panel-hover reveal relative overflow-hidden rounded-4xl p-8 sm:p-10"
              style={`--reveal-delay:${i * 90}ms`}
            >
              <span
                class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-brand-500/10 blur-3xl transition-opacity duration-500 group-hover:opacity-150"
                aria-hidden="true"
              />
              <span class="relative flex h-14 w-14 items-center justify-center rounded-2xl border border-white/12 bg-white/[0.05] text-signal-400">
                <Icon name={service.icon} size={27} />
              </span>
              <p class="relative mt-6 eyebrow">{segment.label}</p>
              <h3 class="relative mt-2 font-display text-2xl font-bold sm:text-3xl">{service.title}</h3>
              <p class="relative mt-4 text-[0.95rem] leading-relaxed text-ink-muted">{service.summary}</p>

              <ul class="relative mt-7 grid gap-2.5 sm:grid-cols-2">
                {segment.points.map((point) => (
                  <li class="flex items-start gap-2.5 text-[0.87rem] text-ink-muted">
                    <Icon name="check" size={16} class="mt-0.5 shrink-0 text-signal-400" />
                    {point}
                  </li>
                ))}
              </ul>

              <span class="relative mt-8 inline-flex items-center gap-2 font-display text-[0.88rem] font-semibold text-gold-400">
                See everything included
                <Icon name="arrow-right" size={16} class="transition-transform group-hover:translate-x-1" />
              </span>
            </a>
          );
        })
      }
    </div>
  </section>

  <!-- ================= Why us ================= -->
  <section class="shell py-14 lg:py-20">
    <div class="mb-10 max-w-3xl">
      <p class="eyebrow">Why Gridless Global</p>
      <h2 class="mt-3 font-display text-3xl font-bold sm:text-4xl lg:text-5xl">
        Engineering first, sales second
      </h2>
      <p class="mt-4 text-[1.02rem] leading-relaxed text-ink-muted">
        Energy is a field where the confident answer is often the wrong one. We would rather be the
        firm that measured it.
      </p>
    </div>

    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {
        differentiators.map((item, i) => (
          <article
            class="panel panel-hover reveal rounded-3xl p-7"
            style={`--reveal-delay:${Math.min(i, 6) * 60}ms`}
          >
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl border border-signal-500/25 bg-signal-500/10 text-signal-400">
              <Icon name={item.icon} size={23} />
            </span>
            <h3 class="mt-5 font-display text-[1.15rem] font-bold">{item.title}</h3>
            <p class="mt-2.5 text-[0.9rem] leading-relaxed text-ink-muted">{item.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- ================= Process ================= -->
  <section class="shell py-14 lg:py-20">
    <div class="panel overflow-hidden rounded-4xl p-8 sm:p-12 lg:p-16">
      <div class="max-w-2xl">
        <p class="eyebrow">How a project runs</p>
        <h2 class="mt-3 font-display text-3xl font-bold sm:text-4xl">Five steps, no surprises</h2>
      </div>

      <ol class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-5 lg:gap-6">
        {
          process.map((item, i) => (
            <li class="reveal relative" style={`--reveal-delay:${i * 80}ms`}>
              {i < process.length - 1 && (
                <span
                  class="absolute left-[1.35rem] top-12 hidden h-[calc(100%-1rem)] w-px bg-gradient-to-b from-white/18 to-transparent sm:block lg:left-12 lg:top-[1.35rem] lg:h-px lg:w-[calc(100%-1rem)] lg:bg-gradient-to-r"
                  aria-hidden="true"
                />
              )}
              <span class="relative z-10 flex h-11 w-11 items-center justify-center rounded-full border border-gold-500/40 bg-navy-900 font-display text-[0.82rem] font-bold text-gold-400">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-5 font-display text-[1.05rem] font-bold">{item.step}</h3>
              <p class="mt-2 text-[0.88rem] leading-relaxed text-ink-muted">{item.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ================= Testimonials ================= -->
  <section class="shell py-14 lg:py-20">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="eyebrow">In their words</p>
        <h2 class="mt-3 font-display text-3xl font-bold sm:text-4xl">What working with us is like</h2>
      </div>
      <Button href="/contact" variant="outline" size="sm" icon="arrow-right">Talk to a specialist</Button>
    </div>

    <div class="grid gap-5 lg:grid-cols-3">
      {
        testimonials.map((item, i) => (
          <figure class="panel reveal flex flex-col rounded-3xl p-7" style={`--reveal-delay:${i * 80}ms`}>
            <Icon name="quote" size={26} class="text-brand-400/70" />
            <blockquote class="mt-5 flex-1 text-[0.98rem] leading-relaxed text-ink">
              {item.quote}
            </blockquote>
            <figcaption class="mt-6 border-t border-white/8 pt-5">
              <p class="font-display text-[0.9rem] font-semibold text-ink">{item.name}</p>
              <p class="mt-0.5 text-[0.82rem] text-ink-faint">{item.role}</p>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <!-- ================= FAQ ================= -->
  <section class="shell py-14 lg:py-20">
    <Faq items={homeFaqs} title="Questions worth asking first" eyebrow="Before you call" />
  </section>

  <CtaBand class="pb-8" />
</BaseLayout>
