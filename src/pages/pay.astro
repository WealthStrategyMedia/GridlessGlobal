---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/PageHero.astro';
import PaymentForm from '~/components/PaymentForm.astro';
import Icon from '~/components/Icon.astro';
import { site } from '~/data/site';
import type { IconName } from '~/components/icons';

const assurances: { icon: IconName; title: string; body: string }[] = [
  {
    icon: 'lock',
    title: 'We never see your card',
    body: 'Card details are entered on our payment provider’s hosted page. Nothing sensitive touches this site or our servers.',
  },
  {
    icon: 'shield-check',
    title: 'PCI-compliant processing',
    body: 'Payments are handled by a certified processor with fraud screening and 3-D Secure where required.',
  },
  {
    icon: 'mail',
    title: 'Instant receipt',
    body: 'A receipt is emailed the moment payment clears, with your invoice or job number on it.',
  },
];

const otherMethods = [
  { label: 'ACH / bank transfer', detail: 'Remittance details are on your invoice, or ask our accounts team.' },
  { label: 'Check', detail: `Payable to ${site.legalName}, posted to the office address in the footer.` },
  { label: 'Financing', detail: 'Loan, lease, PPA and C-PACE options are available on qualifying projects.' },
];
---
<BaseLayout
  title="Make a Payment"
  description={`Pay a ${site.name} invoice, deposit or service call securely online, or find our other accepted payment methods.`}
>
  <PageHero
    eyebrow="Billing"
    title="Make a payment"
    lead="Settle an invoice, deposit or service call in a few seconds. You will be handed to our payment provider to enter card details securely."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Make a Payment' }]}
    icon="credit-card"
    accentClass="text-gold-400"
  />

  <section class="shell py-14 lg:py-20">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,.8fr)] lg:gap-14">
      <PaymentForm />

      <aside class="space-y-5 lg:sticky lg:top-28 lg:self-start">
        <div class="panel rounded-4xl p-7">
          <p class="eyebrow">Security</p>
          <ul class="mt-6 space-y-6">
            {
              assurances.map((item) => (
                <li>
                  <p class="flex items-center gap-2.5 font-display text-[0.98rem] font-bold text-ink">
                    <Icon name={item.icon} size={19} class="shrink-0 text-signal-400" />
                    {item.title}
                  </p>
                  <p class="mt-1.5 pl-7 text-[0.87rem] leading-relaxed text-ink-muted">{item.body}</p>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="panel rounded-4xl p-7">
          <p class="eyebrow">Other ways to pay</p>
          <dl class="mt-6 space-y-5">
            {
              otherMethods.map((method) => (
                <div>
                  <dt class="font-display text-[0.92rem] font-semibold text-ink">{method.label}</dt>
                  <dd class="mt-1 text-[0.85rem] leading-relaxed text-ink-muted">{method.detail}</dd>
                </div>
              ))
            }
          </dl>
          <div class="rule my-6"></div>
          <p class="text-[0.85rem] leading-relaxed text-ink-muted">
            Questions about an invoice? Email
            <a href={`mailto:${site.supportEmail}`} class="text-brand-300 underline underline-offset-2">
              {site.supportEmail}
            </a>
            or call
            <a href={site.phoneHref} class="text-brand-300 underline underline-offset-2">{site.phone}</a>.
          </p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
