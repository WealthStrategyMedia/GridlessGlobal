---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/PageHero.astro';
import Icon from '~/components/Icon.astro';
import Button from '~/components/Button.astro';
import Faq from '~/components/Faq.astro';
import CtaBand from '~/components/CtaBand.astro';
import ServiceCard from '~/components/ServiceCard.astro';
import ContactForm from '~/components/forms/ContactForm.astro';
import ModelViewer from '~/components/ModelViewer.astro';
import FreeOffer from '~/components/FreeOffer.astro';
import LicensedWorkNotice from '~/components/LicensedWorkNotice.astro';
import { services, getService, ACCENTS, SEGMENT_LABELS, involvesRegulatedWork } from '~/data/services';
import { site } from '~/data/site';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug } }));
}

const { slug } = Astro.params;
const service = getService(slug!)!;
const accent = ACCENTS[service.accent];
const related = service.related.map((s) => getService(s)).filter(Boolean) as typeof services;
const regulated = involvesRegulatedWork(service.slug);
/** Pages that discuss insurance or storm work carry the public-adjuster disclosure. */
const mentionsInsurance = /storm damage|adjuster|insurance claim/i.test(JSON.stringify(service));

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Project management and consulting',
    name: regulated ? `${service.title} - project management and consulting` : service.title,
    description: service.summary,
    provider: { '@type': 'Organization', name: site.name, url: site.url },
    areaServed: service.segments.map((s) => SEGMENT_LABELS[s]),
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: `${service.title} - consulting and management services`,
      itemListElement: service.offerings.map((o) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: o.title, description: o.body },
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: service.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Services', item: `${site.url}/services` },
      { '@type': 'ListItem', position: 3, name: service.title, item: `${site.url}/services/${service.slug}` },
    ],
  },
];
---
<BaseLayout title={service.title} description={service.summary} schema={schema}>
  <PageHero
    eyebrow={service.kicker}
    title={service.title}
    lead={service.intro}
    icon={service.icon}
    accentClass={accent.text}
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Services', href: '/services' },
      { label: service.title },
    ]}
  >
    {
      regulated && (
        <p class="mt-7 max-w-3xl text-[0.97rem] leading-relaxed text-ink-muted">
          <strong class="font-semibold text-ink">
            Owner-side project advisory, coordination and administration
          </strong>{' '}
          from planning through closeout. Gridless organizes the people, information,
          documentation, budgets and decisions, while appropriately licensed contractors and
          professionals remain responsible for regulated work.
        </p>
      )
    }

    <div class="mt-8 flex flex-wrap items-center gap-3">
      {
        service.segments.map((segment) => (
          <span class="rounded-full border border-white/12 bg-white/[0.04] px-4 py-2 text-[0.78rem] font-medium tracking-wide text-ink-muted">
            {SEGMENT_LABELS[segment]}
          </span>
        ))
      }
    </div>

    <div class="mt-9 flex flex-col gap-3 sm:flex-row">
      <Button href={`/quote?service=${service.slug}`} variant="gold" size="lg" icon="arrow-right">
        Build my project plan
      </Button>
      <Button href={site.phoneHref} variant="outline" size="lg" icon="phone" iconPosition="start">
        {site.phone}
      </Button>
    </div>
  </PageHero>

  <!-- Highlights + stats -->
  <section class="shell py-14 lg:py-20">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] lg:gap-16">
      <div>
        <p class="eyebrow">{regulated ? 'What we help with' : 'What this covers'}</p>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {
            service.highlights.map((point, i) => (
              <li
                class="reveal flex items-start gap-3.5 rounded-2xl border border-white/8 bg-white/[0.025] px-5 py-4"
                style={`--reveal-delay:${i * 70}ms`}
              >
                <Icon name="check-circle" size={21} class={`mt-px shrink-0 ${accent.text}`} />
                <span class="text-[0.93rem] leading-relaxed text-ink-muted">{point}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Right rail: the numbers, then the standing free offer where it applies. -->
      <div class="space-y-5">
        {
          service.stats && (
            <div class="panel reveal rounded-4xl p-8">
              <p class="eyebrow">By the numbers</p>
              <dl class="mt-6 space-y-7">
                {service.stats.map((stat) => (
                  <div>
                    <dt class={`font-display text-3xl font-extrabold ${accent.text}`}>{stat.value}</dt>
                    <dd class="mt-1.5 text-[0.88rem] leading-relaxed text-ink-muted">{stat.label}</dd>
                  </div>
                ))}
              </dl>
            </div>
          )
        }
        {service.freeOffer && <FreeOffer variant="panel" service={service.slug} />}
      </div>
    </div>
  </section>

  <!-- Interactive 3D model, where one exists for this service -->
  {
    service.models && service.models.length > 0 && (
      <ModelViewer models={service.models} serviceTitle={service.title} accentClass={accent.text} />
    )
  }

  <!-- Offerings -->
  <section class="shell py-14 lg:py-20">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="eyebrow">{regulated ? 'What we organize' : 'In detail'}</p>
        <h2 class="mt-3 font-display text-3xl font-bold sm:text-4xl">
          {regulated
            ? `What Gridless helps organize on your project`
            : `Everything included in ${service.title.toLowerCase()}`}
        </h2>
      </div>
      <Button href="/contact" variant="outline" size="sm" icon="arrow-right">Talk to a project advisor</Button>
    </div>

    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {
        service.offerings.map((offering, i) => (
          <article
            class="panel panel-hover reveal group rounded-3xl p-7"
            style={`--reveal-delay:${Math.min(i, 6) * 60}ms`}
          >
            <span
              class={`flex h-10 w-10 items-center justify-center rounded-xl border ${accent.border} ${accent.bg} font-display text-[0.8rem] font-bold ${accent.text}`}
            >
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-5 font-display text-[1.12rem] font-bold leading-snug">{offering.title}</h3>
            <p class="mt-2.5 text-[0.9rem] leading-relaxed text-ink-muted">{offering.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Process -->
  <section class="shell py-14 lg:py-20">
    <div class="panel overflow-hidden rounded-4xl p-8 sm:p-12">
      <p class="eyebrow">How we work</p>
      <h2 class="mt-3 max-w-2xl font-display text-3xl font-bold sm:text-4xl">
        A sequence that keeps the project honest
      </h2>

      <ol class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-5 lg:gap-6">
        {
          service.process.map((step, i) => (
            <li class="reveal relative" style={`--reveal-delay:${i * 80}ms`}>
              {i < service.process.length - 1 && (
                <span
                  class="absolute left-[1.35rem] top-12 hidden h-[calc(100%-1rem)] w-px bg-gradient-to-b from-white/18 to-transparent sm:block lg:left-12 lg:top-[1.35rem] lg:h-px lg:w-[calc(100%-1rem)] lg:bg-gradient-to-r"
                  aria-hidden="true"
                />
              )}
              <span
                class={`relative z-10 flex h-11 w-11 items-center justify-center rounded-full border ${accent.border} bg-navy-900 font-display text-[0.82rem] font-bold ${accent.text}`}
              >
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-5 font-display text-[1.05rem] font-bold">{step.title}</h3>
              <p class="mt-2 text-[0.88rem] leading-relaxed text-ink-muted">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- FAQs -->
  <section class="shell py-14 lg:py-20">
    <Faq items={service.faqs} />
  </section>

  <!-- Related -->
  {
    related.length > 0 && (
      <section class="shell py-14 lg:py-20">
        <div class="mb-9 flex items-center gap-4">
          <h2 class="font-display text-2xl font-bold sm:text-3xl">Works well with</h2>
          <span class="rule flex-1" />
        </div>
        <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
          {related.map((item, i) => (
            <ServiceCard service={item} index={i} />
          ))}
        </div>
      </section>
    )
  }

  <!-- Enquiry -->
  <section class="shell py-14 lg:py-20">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-16">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="eyebrow">Talk to us</p>
        <h2 class="mt-3 font-display text-3xl font-bold sm:text-4xl">
          Questions about {service.title.toLowerCase()}?
        </h2>
        <p class="mt-5 text-[1rem] leading-relaxed text-ink-muted">
          Send the details and a specialist will come back to you within one business day - not a
          call centre, and not a generic brochure.
        </p>

        <ul class="mt-8 space-y-4">
          <li>
            <a
              href={site.phoneHref}
              class="group flex items-center gap-4 rounded-2xl border border-white/10 bg-white/[0.03] px-5 py-4 transition-colors hover:border-brand-400/40"
            >
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-500/15 text-brand-300">
                <Icon name="phone" size={19} />
              </span>
              <span class="min-w-0 [overflow-wrap:anywhere]">
                <span class="block text-[0.78rem] text-ink-faint">Call us</span>
                <span class="block font-display font-semibold text-ink">{site.phone}</span>
              </span>
            </a>
          </li>
          <li>
            <a
              href={`mailto:${site.email}`}
              class="group flex items-center gap-4 rounded-2xl border border-white/10 bg-white/[0.03] px-5 py-4 transition-colors hover:border-signal-400/40"
            >
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-signal-500/15 text-signal-400">
                <Icon name="mail" size={19} />
              </span>
              <!-- min-w-0 + overflow-wrap:anywhere so a long address wraps
                   instead of forcing the page wider on small phones. -->
              <span class="min-w-0 [overflow-wrap:anywhere]">
                <span class="block text-[0.78rem] text-ink-faint">Email us</span>
                <span class="block font-display font-semibold text-ink">{site.email}</span>
              </span>
            </a>
          </li>
        </ul>
      </div>

      <ContactForm defaultService={service.slug} title={`Enquire about ${service.title.toLowerCase()}`} />
    </div>
  </section>

  {regulated && <LicensedWorkNotice insurance={mentionsInsurance} />}

  <CtaBand class="pb-8" />
</BaseLayout>
