---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/PageHero.astro';
import CtaBand from '~/components/CtaBand.astro';
import Icon from '~/components/Icon.astro';
import Button from '~/components/Button.astro';
import { site } from '~/data/site';
import type { IconName } from '~/components/icons';

const values: { icon: IconName; title: string; body: string }[] = [
  {
    icon: 'gauge',
    title: 'Measure, then recommend',
    body: 'Every recommendation traces back to metered data, a site survey or a tariff analysis. Where a figure came from somebody else, we say so and name the source.',
  },
  {
    icon: 'shield-check',
    title: 'Own the organization',
    body: 'Keeping the project organized is our job, whoever is holding the tools. When something goes unanswered or undocumented, that is ours to chase - and you hear about it from us first.',
  },
  {
    icon: 'users',
    title: 'Plain answers',
    body: 'Energy is full of jargon that obscures weak economics. We would rather explain why a project does not pencil than sell it anyway.',
  },
  {
    icon: 'leaf',
    title: 'Think in decades',
    body: 'Thirty-year assets deserve thirty-year thinking. We help you weigh lifetime performance against the lowest number on the first invoice, so the decision is made with open eyes.',
  },
];

const capabilities = [
  { value: 'Utility scale', label: 'Solar, hydro, thermal, storage and microgrid development coordination, procurement support and project administration' },
  { value: 'Commercial', label: 'Portfolio audits, on-site generation, demand management, carbon and ESG' },
  { value: 'Residential', label: 'Owner-side support on solar, batteries, EV charging, electrical, roofing, siding and construction projects' },
  { value: 'Advisory', label: 'Grant writing, carbon credits, training, workshops and speaker services' },
];

const milestones = [
  {
    title: 'One manager, every trade',
    body: 'Most energy firms sell you hardware and leave the coordination to you. That hand-off is exactly where projects go wrong - the roofer will not touch the panels, the solar company will not touch the roof, and the owner is left refereeing. We take that whole problem on: one scope, one schedule, one person answerable for the result.',
  },
  {
    title: 'Generation and the meter, together',
    body: 'Developing utility-scale plants and wiring a family home look like different businesses. They are not. The same physics, the same interconnection rules and the same economics apply, and working at both ends means the lessons travel in both directions.',
  },
  {
    title: 'Funding is part of the plan',
    body: 'A project that is technically sound and financially unfunded is just a drawing. Grant writing, incentive capture and carbon monetisation sit alongside engineering in our scope because they frequently decide whether anything gets built.',
  },
];
---
<BaseLayout
  title="About Us"
  description={`${site.name} is a project management and energy consulting firm - planning, pricing and managing projects from utility-scale generation through to residential solar, electrical, roofing and construction.`}
>
  <PageHero
    eyebrow="About Gridless Global"
    title="We built Gridless for owners who do not want to manage complex projects alone"
    lead="Projects are rarely difficult because of one trade. They get difficult because dozens of decisions, documents, providers, budgets, technical questions and timelines all have to stay aligned - and somebody has to hold that together."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'About' }]}
    icon="globe"
  />

  <!-- Mission -->
  <section class="shell py-14 lg:py-20">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,.8fr)] lg:gap-16">
      <div class="prose-gg max-w-none">
        <p class="eyebrow">Who we are</p>
        <h2 class="mt-3 font-display text-3xl font-bold sm:text-4xl">
          An organized project command center, on the owner's side of the table
        </h2>
        <p class="mt-6 text-[1.02rem]">
          Gridless Global exists because property and infrastructure projects are rarely difficult
          because of just one trade. They become difficult because dozens of decisions, documents,
          providers, budgets, technical questions and timelines have to stay aligned - and the
          owner is usually the only person who can see all of them at once, with the least time to
          do it.
        </p>
        <p class="mt-5 text-[1.02rem]">
          We work across the whole space because the boundaries between its parts are artificial. A
          solar array is a roofing problem and an electrical problem before it is an energy problem.
          A battery is a tariff problem. A microgrid is a controls problem. Treating those as
          separate jobs, bought separately from people who never speak to each other, is how
          projects end up over budget and underperforming. We put them under one plan instead.
        </p>
        <p class="mt-5 text-[1.02rem]">
          What that means in practice: we help define your objectives, organize the project
          information, coordinate communications, maintain the documentation, track financial and
          project information, identify unresolved items and keep the decision-makers informed.
          When a project requires licensed construction, electrical, roofing, engineering, solar,
          mechanical, EPC or other regulated work, that work is
          <strong>separately contracted with and performed by appropriately licensed independent
          professionals</strong>, who remain responsible for it.
        </p>
        <p class="mt-5 text-[1.02rem]">
          Because our interests sit with you rather than with any supplier, two things follow.
          <strong>The advice is honest</strong> - there is no product line pushing us to tell you
          to buy more than you need. And <strong>you can actually see the project</strong> - what
          was proposed, what it costs, what is outstanding and what happens next. Gridless
          represents the owner's need for clarity, not a trade's need to sell a particular
          solution.
        </p>
        <p class="mt-5 text-[1.02rem]">
          Complex projects have enough moving parts. Your project-management process should not be
          one of them.
        </p>
      </div>

      <div class="panel rounded-4xl p-8">
        <p class="eyebrow">Where we operate</p>
        <dl class="mt-6 space-y-6">
          {
            capabilities.map((item) => (
              <div>
                <dt class="font-display text-[1.05rem] font-bold text-signal-400">{item.value}</dt>
                <dd class="mt-1.5 text-[0.88rem] leading-relaxed text-ink-muted">{item.label}</dd>
              </div>
            ))
          }
        </dl>
        <div class="rule my-7"></div>
        <Button href="/services" variant="outline" size="sm" full icon="arrow-right">
          See all services
        </Button>
      </div>
    </div>
  </section>

  <!-- How we are built -->
  <section class="shell py-14 lg:py-20">
    <div class="mb-10 max-w-2xl">
      <p class="eyebrow">How we are put together</p>
      <h2 class="mt-3 font-display text-3xl font-bold sm:text-4xl">Three deliberate decisions</h2>
    </div>

    <div class="grid gap-5 lg:grid-cols-3">
      {
        milestones.map((item, i) => (
          <article class="panel reveal rounded-4xl p-8" style={`--reveal-delay:${i * 80}ms`}>
            <span class="flex h-11 w-11 items-center justify-center rounded-full border border-gold-500/35 bg-gold-500/10 font-display text-[0.85rem] font-bold text-gold-400">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-6 font-display text-[1.2rem] font-bold leading-snug">{item.title}</h3>
            <p class="mt-3 text-[0.92rem] leading-relaxed text-ink-muted">{item.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Values -->
  <section class="shell py-14 lg:py-20">
    <div class="panel overflow-hidden rounded-4xl p-8 sm:p-12 lg:p-16">
      <div class="max-w-2xl">
        <p class="eyebrow">What we hold to</p>
        <h2 class="mt-3 font-display text-3xl font-bold sm:text-4xl">The way we work</h2>
      </div>

      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:gap-12">
        {
          values.map((value, i) => (
            <div class="reveal flex gap-5" style={`--reveal-delay:${i * 80}ms`}>
              <span class="flex h-13 w-13 shrink-0 items-center justify-center rounded-2xl border border-signal-500/25 bg-signal-500/10 text-signal-400">
                <Icon name={value.icon} size={24} />
              </span>
              <div>
                <h3 class="font-display text-[1.12rem] font-bold">{value.title}</h3>
                <p class="mt-2 text-[0.92rem] leading-relaxed text-ink-muted">{value.body}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    class="pb-8"
    title="Bring us a problem, not a product list"
    body="Tell us what the building is doing, what it costs you and what you wish it did instead. The specification comes after that conversation, not before it."
    primaryLabel="Start the conversation"
    primaryHref="/contact"
  />
</BaseLayout>

<style>
  .h-13 { height: 3.25rem; }
  .w-13 { width: 3.25rem; }
</style>
