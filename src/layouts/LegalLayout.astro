---
import BaseLayout from './BaseLayout.astro';
import PageHero from '~/components/PageHero.astro';
import Icon from '~/components/Icon.astro';

interface Props {
  title: string;
  description: string;
  updated: string;
  /** Shows the "template - have counsel review" banner. */
  draft?: boolean;
}

const { title, description, updated, draft = true } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <PageHero
    eyebrow="Legal"
    title={title}
    crumbs={[{ label: 'Home', href: '/' }, { label: title }]}
    icon="file-text"
  >
    <p class="mt-6 text-[0.88rem] text-ink-faint">Last updated: {updated}</p>
  </PageHero>

  <section class="shell py-14 lg:py-20">
    <div class="mx-auto max-w-3xl">
      {
        draft && (
          <p class="mb-10 flex items-start gap-3 rounded-2xl border border-gold-500/25 bg-gold-500/[0.07] px-5 py-4 text-[0.85rem] leading-relaxed text-gold-200/90">
            <Icon name="info" size={18} class="mt-px shrink-0" />
            <span>
              <strong class="font-semibold">Template pending review.</strong> This document is a
              starting point and has not been reviewed by counsel. Replace it with your own policy
              before the site handles live customer data.
            </span>
          </p>
        )
      }

      <div class="legal-body prose-gg">
        <slot />
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .legal-body h2 {
    margin-top: 2.75rem;
    margin-bottom: 0.9rem;
    font-size: 1.4rem;
    font-weight: 700;
  }
  .legal-body h2:first-child { margin-top: 0; }
  .legal-body h3 {
    margin-top: 1.9rem;
    margin-bottom: 0.6rem;
    font-size: 1.08rem;
    font-weight: 600;
  }
  .legal-body p { margin-bottom: 1.1rem; }
  .legal-body ul {
    margin-bottom: 1.3rem;
    padding-left: 1.3rem;
    list-style: disc;
  }
  .legal-body li {
    margin-bottom: 0.5rem;
    color: var(--color-ink-muted);
    line-height: 1.7;
  }
</style>
